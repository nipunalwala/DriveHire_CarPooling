# Run node scripts/init-local-env.mjs to generate private local credentials in .env.
# This file names configuration only; it contains no usable credential.
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
POSTGRES_USER=drivehire_migrator
POSTGRES_DB=drivehire_dev
POSTGRES_PASSWORD=replace-locally
RUNTIME_DB_USER=drivehire_runtime
RUNTIME_DB_PASSWORD=replace-locally
DATABASE_URL=postgresql://drivehire_runtime:replace-locally@127.0.0.1:5432/drivehire_dev
MIGRATION_DATABASE_URL=postgresql://drivehire_migrator:replace-locally@127.0.0.1:5432/drivehire_dev
TEST_POSTGRES_USER=drivehire_test_migrator
TEST_POSTGRES_PASSWORD=replace-locally
TEST_RUNTIME_DB_PASSWORD=replace-locally
TEST_DATABASE_URL=postgresql://drivehire_test_runtime:replace-locally@127.0.0.1:55433/drivehire_test
TEST_MIGRATION_DATABASE_URL=postgresql://drivehire_test_migrator:replace-locally@127.0.0.1:55433/drivehire_test
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_TLS=none
MAIL_FROM=no-reply@drivehire.local
# Private secrets: generate locally, never commit usable values.
# AUTH_JWT_SECRET must be at least 32 characters in staging/production.
AUTH_JWT_SECRET=replace-locally
# 32-byte base64url/hex AEAD key protecting authentication outbox secrets.
AUTH_OUTBOX_KEY=replace-locally
SCAN_HOST=127.0.0.1
SCAN_PORT=3310
STORAGE_PRIVATE_ROOT=./private-storage
WORKER_POLL_MS=5000
VITE_API_BASE_URL=/api/v1
